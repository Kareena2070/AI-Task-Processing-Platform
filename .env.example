# ==========================================
# AI Task Processing Platform - Environment Config
# ==========================================

# Port Mappings (Host)
FRONTEND_PORT=5173
BACKEND_PORT=5000

# Backend Security
JWT_SECRET=658e82e2de837f2f4400b3ab0150ae7f43ace5f87cc46f502f3173efcce77d5b
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Database & Cache (Docker compose internal network defaults)
MONGODB_URI=mongodb://mongodb:27017/ai-task-platform
REDIS_URL=redis://redis:6379

# Worker Configuration
REDIS_STREAM=task_stream
REDIS_CONSUMER_GROUP=task_workers_group
REDIS_CONSUMER_NAME=
REDIS_BLOCK_MS=2000
REDIS_BATCH_SIZE=10
PROCESSING_LEASE_SECONDS=60
AUTOCLAIM_MIN_IDLE_MS=70000
RECOVERY_POLLING_INTERVAL_SECONDS=10.0
MAX_RETRIES=3
DEAD_LETTER_STREAM=task_stream:dead_letter
